{
  "name": "wentkompany",
  "version": "0.3.0",
  "private": true,
  "description": "WENTKOMPANY — производство гидрозонтов, гидрофильтров и вытяжных зонтов",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "data": "node scripts/build-data.mjs",
    "check": "node --experimental-strip-types scripts/check-calc.mjs",
    "check:ifc": "node --experimental-strip-types scripts/check-ifc.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:all": "npm run check && npm run check:ifc && npm run check:redirects",
    "images": "node scripts/fetch-images.mjs",
    "prebuild": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/oswald": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^15.5.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "dejavu-fonts-ttf": "^2.37.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "web-ifc": "^0.0.77"
  }
}
