# Публичный адрес сайта — используется в metadata, sitemap и JSON-LD
NEXT_PUBLIC_SITE_URL=https://wentkompany.ru

# Заявки в Telegram (BotFather → токен; chat_id личного чата или группы менеджеров)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Вебхук CRM (amoCRM / Битрикс24 / собственный приёмник)
CRM_WEBHOOK_URL=

# Яндекс.Метрика. Пока переменная пуста, счётчик не подключается вовсе
# и в браузер посетителя не уходит ни одного запроса к Яндексу.
NEXT_PUBLIC_YM_ID=

# HSTS. Включать (=1) только после HTTPS. На Amvera — в amvera.build.env; на Timeweb — здесь и в build-args compose.
ENABLE_HSTS=0
