# Публичные переменные, вшиваемые в бандл при npm run build.
# На Amvera переменные из панели на этапе сборки недоступны — правьте этот файл и пушьте в git.
# https://docs.amvera.ru/applications/configuration/variables.html

NEXT_PUBLIC_SITE_URL=https://wentkompany.ru
NEXT_PUBLIC_YM_ID=

# HSTS: 0 до проверки HTTPS на домене, 1 после — заголовок задаётся в next.config.ts при сборке
ENABLE_HSTS=0
